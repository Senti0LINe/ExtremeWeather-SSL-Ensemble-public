# Generated deliverables and data artifacts.
# Marking them linguist-generated keeps them out of GitHub's language statistics
# (the self-contained forecaster panels are ~10 MB of base64-embedded imagery and
# would otherwise drown out the ~0.3 MB of actual Python), and collapses them in
# pull-request diffs.

# Forecaster panels: generated by tools/make_panel_v2.py and tools/make_panel.py
reports/panels/*.html linguist-generated=true
reports/panels/*.json linguist-generated=true

# Figures: generated by the evaluation and panel scripts
reports/figures/*.png linguist-generated=true
docs/panel_example.jpg linguist-generated=true

# Experiment outputs: metrics, predictions, features, weights
experiments/**/*.json linguist-generated=true
experiments/**/*.png linguist-generated=true
experiments/**/*.npz linguist-generated=true
experiments/**/*.pt linguist-generated=true
experiments/**/*.pkl linguist-generated=true

# Frozen split manifests: produced by the split-selection scripts
splits_v1.json linguist-generated=true
splits_test_eval.json linguist-generated=true

# Prose documentation: kept out of the language bar so the stats reflect code
*.md linguist-documentation=true
LICENSE linguist-documentation=true